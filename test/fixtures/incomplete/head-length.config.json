  "counting": "graphemes",
  "duplicateScope": "locale",
  "defaults": {
    "title": {
      "min": 1,
      "max": 200
    },
    "description": {
      "min": 1,
      "max": 500
    }
  },
  "locales": {
    "en": {}
  },
  "pages": [
