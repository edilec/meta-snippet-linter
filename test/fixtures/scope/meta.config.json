{
  "schemaVersion": "1",
  "counting": "graphemes",
  "duplicateScope": "locale",
  "defaults": {
    "title": {
      "min": 1,
      "max": 200
    },
    "description": {
      "min": 1,
      "max": 500
    }
  },
  "locales": {
    "en": {},
    "de": {}
  },
  "pages": [
    {
      "path": "/en/",
      "file": "build/en.html",
      "locale": "en"
    },
    {
      "path": "/de/",
      "file": "build/de.html",
      "locale": "de"
    }
  ]
}
