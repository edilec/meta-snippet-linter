{
  "schemaVersion": "1",
  "counting": "graphemes",
  "duplicateScope": "locale",
  "defaults": {
    "title": {
      "min": 20,
      "max": 60
    },
    "description": {
      "min": 70,
      "max": 120
    }
  },
  "locales": {
    "en": {}
  },
  "pages": [
    {
      "path": "/long",
      "file": "build/long.html",
      "locale": "en"
    },
    {
      "path": "/short",
      "file": "build/short.html",
      "locale": "en"
    }
  ]
}
